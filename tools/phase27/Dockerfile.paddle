FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir paddlepaddle==3.3.1 "paddleocr[doc-parser]==3.7.0"
WORKDIR /work
COPY tools/phase27/paddle_extract.py /usr/local/bin/paddle_extract.py
ENTRYPOINT ["python", "/usr/local/bin/paddle_extract.py"]
