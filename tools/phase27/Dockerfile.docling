FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir docling==2.126.0
WORKDIR /work
COPY tools/phase27/docling_extract.py /usr/local/bin/docling_extract.py
ENTRYPOINT ["python", "/usr/local/bin/docling_extract.py"]
